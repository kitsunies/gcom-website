{
  "name": "@gcom/web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:content && tsx scripts/html.ts && vite --host 0.0.0.0",
    "build": "npm run sync:content && npm run build:snapshot",
    "test": "tsx --test tests/*.test.ts",
    "sync:events": "tsx scripts/import-events.ts",
    "preview": "vite preview --host 0.0.0.0",
    "sync:content": "tsx scripts/site-content.ts",
    "build:snapshot": "tsc --noEmit && tsx scripts/html.ts && vite build && vite build --ssr src/prerender.tsx --outDir .build && tsx scripts/prerender.ts",
    "build:release": "CONTENT_SOURCE=sanity npm run build",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@fontsource/aldrich": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/nova-square": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@sanity/client": "8.9.0",
    "@sanity/image-url": "2.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "node-ical": "0.27.3",
    "playwright": "1.64.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  }
}
