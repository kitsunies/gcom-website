{
  "name": "gcom-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/html.ts && vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsx scripts/html.ts && vite build && vite build --ssr src/prerender.tsx --outDir .build && tsx scripts/prerender.ts",
    "test": "tsx --test tests/*.test.ts",
    "sync:events": "tsx scripts/import-events.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/geo": "^5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "node-ical": "0.27.3",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  }
}
