# Copy to a mode-600 file outside source; leave credentials blank for setup-required mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EDITOR_ORIGIN=http://localhost:4174
GITHUB_REPOSITORY=
GITHUB_BRANCH=
GITHUB_TOKEN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# Local development only; compose supplies this path automatically.
COMMITTEE_ALLOWLIST_FILE=
# Optional HTTPS public snapshot URL to verify a successful workflow is live.
PUBLIC_TEAM_URL=

# Public contact route: /api/contact accepts POST JSON and narrow OPTIONS only.
# Store SMTP credentials in the mode-600 operator file outside source.
# Without valid host/user/pass/from/port, valid submissions return 503 with a direct-email fallback.
CONTACT_ALLOWED_ORIGIN=https://gcom.techtom.tech
# Temporary recipient explicitly approved by the user; never taken from the request.
CONTACT_RECIPIENT=kitsunies@gmail.com
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
# A single mailbox authorized by your SMTP provider; no display name or address list.
CONTACT_SMTP_FROM=
# Port 465 uses implicit TLS; other ports require STARTTLS with certificate validation.
# No Origin, wrong Origin, non-JSON bodies and control characters are rejected.
# Limits: name 100, email 254, subject 150, message 5000, request JSON 16KiB.
# Five POST attempts per source IP per ten minutes, including failed delivery attempts.
# At most 1000 in-memory IP buckets; new IPs are denied when full until expiry.
# Limits reset on restart; use a shared edge limiter before running multiple replicas.
# By default X-Forwarded-For is ignored: proxied traffic shares the proxy's IP bucket.
# Set exact socket peer IPs only if that proxy OVERWRITES X-Forwarded-For with ONE
# validated client IP and direct access to Node is blocked. Lists/malformed headers
# fall back to the socket IP; never set this merely to accept arbitrary forwarded headers.
CONTACT_TRUSTED_PROXY_IPS=
